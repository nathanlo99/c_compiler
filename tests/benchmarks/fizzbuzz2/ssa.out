@fizzbuzz(n: int) : int {
  %0: int = const 15;
  %1: int = mod n %0;
  %2: int = const 0;
  %3: int = eq %1 %2;
  br %3 .L1 .L2;
.L1:                                               preds = {.L0}, dominators = {.L0, .L1}, escapes = {}
  %4: int = const -15;
  ret %4;
.L2:                                               preds = {.L0}, dominators = {.L0, .L2}, escapes = {}
  %5: int = const 3;
  %6: int = mod n %5;
  %7: int = eq %6 %2;
  br %7 .L3 .L4;
.L3:                                               preds = {.L2}, dominators = {.L0, .L2, .L3}, escapes = {}
  %8: int = const -3;
  ret %8;
.L4:                                               preds = {.L2}, dominators = {.L0, .L2, .L4}, escapes = {}
  %9: int = const 5;
  %10: int = mod n %9;
  %11: int = eq %10 %2;
  br %11 .L5 .L6;
.L5:                                               preds = {.L4}, dominators = {.L0, .L2, .L4, .L5}, escapes = {}
  %12: int = const -5;
  ret %12;
.L6:                                               preds = {.L4}, dominators = {.L0, .L2, .L4, .L6}, escapes = {}
  ret n;
}

@wain(start: int, end: int) : int {
  %0: int = id start;
  jmp .L1;
.L1:                                               preds = {.L0, .L2}, dominators = {.L0, .L1}, escapes = {%2}
  %2: int = phi .L0 start .L2 %1;
  %3: int = lt %2 end;
  br %3 .L2 .L3;
.L2:                                               preds = {.L1}, dominators = {.L0, .L1, .L2}, escapes = {%1}
  %4: int = call @fizzbuzz %2;
  print %4;
  %5: int = const 1;
  %1: int = add %2 %5;
  %6: int = id %1;
  jmp .L1;
.L3:                                               preds = {.L1}, dominators = {.L0, .L1, .L3}, escapes = {}
  ret %2;
}

