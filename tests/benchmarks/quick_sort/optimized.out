@fastSort(array: ptr<int>, left: int, right: int) : int {
  %0: int = const 0;
  %1: int = le %0 left;
  %2: int = const 0;
  br %1 .L1 .L2;
.L1:                                               preds = {.L0}, dominators = {.L1, .L0}
  %3: int = le %0 right;
  %2: int = id %3;
  jmp .L2;
.L2:                                               preds = {.L1, .L0}, dominators = {.L2, .L0}
  %4: int = id %0;
  br %2 .L3 .L4;
.L3:                                               preds = {.L2}, dominators = {.L3, .L2, .L0}
  %5: int = lt left right;
  %4: int = id %5;
  jmp .L4;
.L4:                                               preds = {.L3, .L2}, dominators = {.L4, .L2, .L0}
  %6: int = eq %4 %0;
  br %6 .L5 .L6;
.L5:                                               preds = {.L4}, dominators = {.L4, .L2, .L5, .L0}
  jmp .L7;
.L6:                                               preds = {.L4}, dominators = {.L6, .L4, .L2, .L0}
  %7: int = call @partition array left right;
  %8: int = call @fastSort array left %7;
  %9: int = const 1;
  %10: int = add %7 %9;
  %11: int = call @fastSort array %10 right;
  jmp .L7;
.L7:                                               preds = {.L6, .L5}, dominators = {.L7, .L4, .L2, .L0}
  ret %0;
}

@partition(array: ptr<int>, left: int, right: int) : int {
  %0: int = const 0;
  %1: int = const 0;
  %2: int = const 0;
  %3: int = const 0;
  %4: ptr<int> = id array;
  %5: int = id left;
  %6: ptr<int> = ptradd %4 %5;
  %7: int = load %6;
  %0: int = id %7;
  %8: int = id left;
  %9: int = const 1;
  %10: int = sub %8 %9;
  %1: int = id %10;
  %11: int = id right;
  %12: int = const 1;
  %13: int = add %11 %12;
  %2: int = id %13;
  jmp .L1;
.L1:                                               preds = {.L0, .L10}, dominators = {.L1, .L0}
  %14: int = lt %1 %2;
  br %14 .L2 .L11;
.L2:                                               preds = {.L1}, dominators = {.L2, .L1, .L0}
  %15: int = const 1;
  %16: int = add %1 %15;
  %1: int = id %16;
  jmp .L3;
.L3:                                               preds = {.L2, .L4}, dominators = {.L3, .L2, .L1, .L0}
  %17: ptr<int> = id array;
  %18: int = id %1;
  %19: ptr<int> = ptradd %17 %18;
  %20: int = load %19;
  %21: int = id %0;
  %22: int = lt %20 %21;
  br %22 .L4 .L5;
.L4:                                               preds = {.L3}, dominators = {.L4, .L3, .L2, .L1, .L0}
  %23: int = const 1;
  %24: int = add %1 %23;
  %1: int = id %24;
  jmp .L3;
.L5:                                               preds = {.L3}, dominators = {.L3, .L2, .L5, .L1, .L0}
  %25: int = const 1;
  %26: int = sub %2 %25;
  %2: int = id %26;
  jmp .L6;
.L6:                                               preds = {.L7, .L5}, dominators = {.L6, .L3, .L2, .L5, .L1, .L0}
  %27: ptr<int> = id array;
  %28: int = id %2;
  %29: ptr<int> = ptradd %27 %28;
  %30: int = load %29;
  %31: int = id %0;
  %32: int = gt %30 %31;
  br %32 .L7 .L8;
.L7:                                               preds = {.L6}, dominators = {.L6, .L3, .L2, .L7, .L5, .L1, .L0}
  %33: int = const 1;
  %34: int = sub %2 %33;
  %2: int = id %34;
  jmp .L6;
.L8:                                               preds = {.L6}, dominators = {.L8, .L6, .L3, .L2, .L5, .L1, .L0}
  %35: int = lt %1 %2;
  br %35 .L9 .L10;
.L9:                                               preds = {.L8}, dominators = {.L9, .L8, .L6, .L3, .L2, .L5, .L1, .L0}
  %36: ptr<int> = id array;
  %37: int = id %1;
  %38: ptr<int> = ptradd %36 %37;
  %39: int = load %38;
  %3: int = id %39;
  %40: ptr<int> = id array;
  %41: int = id %2;
  %42: ptr<int> = ptradd %40 %41;
  %43: int = load %42;
  %44: ptr<int> = id array;
  %45: int = id %1;
  %46: ptr<int> = ptradd %44 %45;
  store %46 %43;
  %47: int = id %3;
  %48: ptr<int> = id array;
  %49: int = id %2;
  %50: ptr<int> = ptradd %48 %49;
  store %50 %47;
  jmp .L10;
.L10:                                              preds = {.L9, .L8}, dominators = {.L8, .L6, .L3, .L2, .L5, .L1, .L10, .L0}
  jmp .L1;
.L11:                                              preds = {.L1}, dominators = {.L11, .L1, .L0}
  ret %2;
}

@wain(a: ptr<int>, b: int) : int {
  %0: int = const 0;
  jmp .L1;
.L1:                                               preds = {.L2, .L0}, dominators = {.L1, .L0}
  %1: int = lt %0 b;
  br %1 .L2 .L3;
.L2:                                               preds = {.L1}, dominators = {.L2, .L1, .L0}
  %2: ptr<int> = id a;
  %3: int = id %0;
  %4: ptr<int> = ptradd %2 %3;
  %5: int = load %4;
  print %5;
  %6: int = const 1;
  %7: int = add %0 %6;
  %0: int = id %7;
  jmp .L1;
.L3:                                               preds = {.L1}, dominators = {.L3, .L1, .L0}
  %8: int = const 0;
  %9: int = const 1;
  %10: int = sub b %9;
  %11: int = call @fastSort a %8 %10;
  %0: int = const 0;
  jmp .L4;
.L4:                                               preds = {.L5, .L3}, dominators = {.L4, .L3, .L1, .L0}
  %12: int = lt %0 b;
  br %12 .L5 .L6;
.L5:                                               preds = {.L4}, dominators = {.L4, .L3, .L5, .L1, .L0}
  %13: ptr<int> = id a;
  %14: int = id %0;
  %15: ptr<int> = ptradd %13 %14;
  %16: int = load %15;
  print %16;
  %17: int = const 1;
  %18: int = add %0 %17;
  %0: int = id %18;
  jmp .L4;
.L6:                                               preds = {.L4}, dominators = {.L6, .L4, .L3, .L1, .L0}
  %19: int = const 0;
  ret %19;
}

