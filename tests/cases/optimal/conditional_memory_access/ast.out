Procedure {
  name: wain
  return_type: int
  parameters: 
    a: int (used)
    b: int (used)
  declarations: 
    c: int* = 1 (used)
  statements: 
    IfStatement {
      condition: 
        BinaryExpr {
          lhs: 
            VariableExpr(b) : int
          operation: LessThan
          rhs: 
            VariableExpr(a) : int
        } : int
      true_statement: 
        ExprStatement {
          AssignmentExpr {
            lhs: 
              VariableLValueExpr(c) : int*
            rhs: 
              AddressOfExpr {
                VariableLValueExpr(a) : int
              } : int*
          } : int*
        }
      false_statement: 
        ExprStatement {
          AssignmentExpr {
            lhs: 
              VariableLValueExpr(c) : int*
            rhs: 
              AddressOfExpr {
                VariableLValueExpr(b) : int
              } : int*
          } : int*
        }
    }
    ReturnStatement {
      DereferenceExpr {
        VariableExpr(c) : int*
      } : int
    }
}

