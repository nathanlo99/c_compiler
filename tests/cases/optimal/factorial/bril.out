@factorial(a: int) : int {
  result: int = const 0;
  _t0: int = const 1;
  _t1: int = id a;
  _t2: int = lt _t0 _t1;
  br _t2 ifTrue0 ifFalse0;
ifTrue0:                                           preds = {factorialEntry}, dominators = {ifTrue0, factorialEntry}
  _t3: int = id a;
  _t4: int = id a;
  _t5: int = const 1;
  _t6: int = sub _t4 _t5;
  _t7: int = call @factorial _t6;
  _t8: int = mul _t3 _t7;
  result: int = id _t8;
  _t9: int = id result;
  jmp ifEndif0;
ifFalse0:                                          preds = {factorialEntry}, dominators = {ifFalse0, factorialEntry}
  _t10: int = const 1;
  result: int = id _t10;
  _t11: int = id result;
  jmp ifEndif0;
ifEndif0:                                          preds = {ifFalse0, ifTrue0}, dominators = {ifEndif0, factorialEntry}
  _t12: int = id result;
  ret _t12;
}

@wain(a: int, result: int) : int {
  _t13: int = id a;
  _t14: int = call @factorial _t13;
  result: int = id _t14;
  _t15: int = id result;
  _t16: int = id result;
  ret _t16;
}

