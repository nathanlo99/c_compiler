Procedure {
  name: factorial
  return_type: int
  parameters: 
    a: int (used)
  declarations: 
    result: int = 0 (used)
  statements: 
    IfStatement {
      condition: 
        BinaryExpr {
          lhs: 
            1: int
          operation: LessThan
          rhs: 
            VariableExpr(a) : int
        } : int
      true_statement: 
        ExprStatement {
          AssignmentExpr {
            lhs: 
              VariableLValueExpr(result) : int
            rhs: 
              BinaryExpr {
                lhs: 
                  VariableExpr(a) : int
                operation: Mul
                rhs: 
                  FunctionCall {
                    procedure_name: factorial,
                    arguments: [
                      BinaryExpr {
                        lhs: 
                          VariableExpr(a) : int
                        operation: Sub
                        rhs: 
                          1: int
                      } : int
                    ]
                  } : int
              } : int
          } : int
        }
      false_statement: 
        ExprStatement {
          AssignmentExpr {
            lhs: 
              VariableLValueExpr(result) : int
            rhs: 
              1: int
          } : int
        }
    }
    ReturnStatement {
      VariableExpr(result) : int
    }
}

Procedure {
  name: wain
  return_type: int
  parameters: 
    a: int (used)
    result: int (used)
  declarations: 
  statements: 
    ExprStatement {
      AssignmentExpr {
        lhs: 
          VariableLValueExpr(result) : int
        rhs: 
          FunctionCall {
            procedure_name: factorial,
            arguments: [
              VariableExpr(a) : int
            ]
          } : int
      } : int
    }
    ReturnStatement {
      VariableExpr(result) : int
    }
}

