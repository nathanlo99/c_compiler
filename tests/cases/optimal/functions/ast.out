Procedure {
  name: f
  return_type: int
  parameters: 
    a: int (unused)
    b: int (used)
  declarations: 
    c: int = 0 (used)
    d: int* = 1 (used)
  statements: 
    ExprStatement {
      AssignmentExpr {
        lhs: 
          VariableLValueExpr(d) : int*
        rhs: 
          AddressOfExpr {
            VariableLValueExpr(b) : int
          } : int*
      } : int*
    }
    ExprStatement {
      AssignmentExpr {
        lhs: 
          VariableLValueExpr(d) : int*
        rhs: 
          AddressOfExpr {
            VariableLValueExpr(c) : int
          } : int*
      } : int*
    }
    ReturnStatement {
      DereferenceExpr {
        VariableExpr(d) : int*
      } : int
    }
}

Procedure {
  name: wain
  return_type: int
  parameters: 
    a: int (used)
    b: int (used)
  declarations: 
  statements: 
    ReturnStatement {
      FunctionCall {
        procedure_name: f,
        arguments: [
          VariableExpr(a) : int
          VariableExpr(b) : int
        ]
      } : int
    }
}

