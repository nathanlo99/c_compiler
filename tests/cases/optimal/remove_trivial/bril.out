@wain(a: int, b: int) : int {
  c: int = const 0;
  _t0: int = id a;
  _t1: int = id b;
  _t2: int = eq _t0 _t1;
  br _t2 ifTrue0 ifFalse0;
ifTrue0:                                           preds = {wainEntry}, dominators = {ifTrue0, wainEntry}
  _t3: int = const 0;
  c: int = id _t3;
  _t4: int = id c;
  _t5: int = id c;
  _t6: int = const 1;
  _t7: int = eq _t5 _t6;
  br _t7 ifTrue1 ifFalse1;
ifTrue1:                                           preds = {ifTrue0}, dominators = {ifTrue1, ifTrue0, wainEntry}
  _t8: int = const 2;
  c: int = id _t8;
  _t9: int = id c;
  jmp ifFalse1;
ifFalse1:                                          preds = {ifTrue1, ifTrue0}, dominators = {ifTrue0, ifFalse1, wainEntry}
  jmp ifFalse0;
ifFalse0:                                          preds = {ifFalse1, wainEntry}, dominators = {ifFalse0, wainEntry}
  _t10: int = id c;
  ret _t10;
}

