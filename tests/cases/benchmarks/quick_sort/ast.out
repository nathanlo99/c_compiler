Procedure {
  name: partition
  return_type: int
  parameters: 
    array: int* (used)
    left: int (used)
    right: int (used)
  declarations: 
    pivot: int = 0 (used)
    i: int = 0 (used)
    j: int = 0 (used)
    temp: int = 0 (used)
    ret: int = 0 (used)
  statements: 
    ExprStatement {
      AssignmentExpr {
        lhs: 
          VariableLValueExpr(pivot) : int
        rhs: 
          DereferenceExpr {
            BinaryExpr {
              lhs: 
                VariableExpr(array) : int*
              operation: Add
              rhs: 
                VariableExpr(left) : int
            } : int*
          } : int
      } : int
    }
    ExprStatement {
      AssignmentExpr {
        lhs: 
          VariableLValueExpr(i) : int
        rhs: 
          BinaryExpr {
            lhs: 
              VariableExpr(left) : int
            operation: Sub
            rhs: 
              1: int
          } : int
      } : int
    }
    ExprStatement {
      AssignmentExpr {
        lhs: 
          VariableLValueExpr(j) : int
        rhs: 
          BinaryExpr {
            lhs: 
              VariableExpr(right) : int
            operation: Add
            rhs: 
              1: int
          } : int
      } : int
    }
    WhileStatement {
      condition: 
        BinaryExpr {
          lhs: 
            VariableExpr(i) : int
          operation: LessThan
          rhs: 
            VariableExpr(j) : int
        } : int
      body: 
        ExprStatement {
          AssignmentExpr {
            lhs: 
              VariableLValueExpr(i) : int
            rhs: 
              BinaryExpr {
                lhs: 
                  VariableExpr(i) : int
                operation: Add
                rhs: 
                  1: int
              } : int
          } : int
        }
        WhileStatement {
          condition: 
            BinaryExpr {
              lhs: 
                DereferenceExpr {
                  BinaryExpr {
                    lhs: 
                      VariableExpr(array) : int*
                    operation: Add
                    rhs: 
                      VariableExpr(i) : int
                  } : int*
                } : int
              operation: LessThan
              rhs: 
                VariableExpr(pivot) : int
            } : int
          body: 
            ExprStatement {
              AssignmentExpr {
                lhs: 
                  VariableLValueExpr(i) : int
                rhs: 
                  BinaryExpr {
                    lhs: 
                      VariableExpr(i) : int
                    operation: Add
                    rhs: 
                      1: int
                  } : int
              } : int
            }
        }
        ExprStatement {
          AssignmentExpr {
            lhs: 
              VariableLValueExpr(j) : int
            rhs: 
              BinaryExpr {
                lhs: 
                  VariableExpr(j) : int
                operation: Sub
                rhs: 
                  1: int
              } : int
          } : int
        }
        WhileStatement {
          condition: 
            BinaryExpr {
              lhs: 
                DereferenceExpr {
                  BinaryExpr {
                    lhs: 
                      VariableExpr(array) : int*
                    operation: Add
                    rhs: 
                      VariableExpr(j) : int
                  } : int*
                } : int
              operation: GreaterThan
              rhs: 
                VariableExpr(pivot) : int
            } : int
          body: 
            ExprStatement {
              AssignmentExpr {
                lhs: 
                  VariableLValueExpr(j) : int
                rhs: 
                  BinaryExpr {
                    lhs: 
                      VariableExpr(j) : int
                    operation: Sub
                    rhs: 
                      1: int
                  } : int
              } : int
            }
        }
        IfStatement {
          condition: 
            BinaryExpr {
              lhs: 
                VariableExpr(i) : int
              operation: LessThan
              rhs: 
                VariableExpr(j) : int
            } : int
          true_statement: 
            ExprStatement {
              AssignmentExpr {
                lhs: 
                  VariableLValueExpr(temp) : int
                rhs: 
                  DereferenceExpr {
                    BinaryExpr {
                      lhs: 
                        VariableExpr(array) : int*
                      operation: Add
                      rhs: 
                        VariableExpr(i) : int
                    } : int*
                  } : int
              } : int
            }
            ExprStatement {
              AssignmentExpr {
                lhs: 
                  DereferenceLValueExpr {
                    BinaryExpr {
                      lhs: 
                        VariableExpr(array) : int*
                      operation: Add
                      rhs: 
                        VariableExpr(i) : int
                    } : int*
                  } : int
                rhs: 
                  DereferenceExpr {
                    BinaryExpr {
                      lhs: 
                        VariableExpr(array) : int*
                      operation: Add
                      rhs: 
                        VariableExpr(j) : int
                    } : int*
                  } : int
              } : int
            }
            ExprStatement {
              AssignmentExpr {
                lhs: 
                  DereferenceLValueExpr {
                    BinaryExpr {
                      lhs: 
                        VariableExpr(array) : int*
                      operation: Add
                      rhs: 
                        VariableExpr(j) : int
                    } : int*
                  } : int
                rhs: 
                  VariableExpr(temp) : int
              } : int
            }
          false_statement: 
        }
    }
    ExprStatement {
      AssignmentExpr {
        lhs: 
          VariableLValueExpr(ret) : int
        rhs: 
          VariableExpr(j) : int
      } : int
    }
    ReturnStatement {
      VariableExpr(ret) : int
    }
}

Procedure {
  name: fastSort
  return_type: int
  parameters: 
    array: int* (used)
    left: int (used)
    right: int (used)
  declarations: 
    skip: int = 0 (used)
    pivot: int = 0 (used)
  statements: 
    IfStatement {
      condition: 
        BinaryExpr {
          lhs: 
            BooleanAndExpr {
              lhs: 
                BooleanAndExpr {
                  lhs: 
                    BinaryExpr {
                      lhs: 
                        VariableExpr(left) : int
                      operation: GreaterEqual
                      rhs: 
                        0: int
                    } : int
                  rhs: 
                    BinaryExpr {
                      lhs: 
                        VariableExpr(right) : int
                      operation: GreaterEqual
                      rhs: 
                        0: int
                    } : int
                } : int
              rhs: 
                BinaryExpr {
                  lhs: 
                    VariableExpr(left) : int
                  operation: LessThan
                  rhs: 
                    VariableExpr(right) : int
                } : int
            } : int
          operation: Equal
          rhs: 
            0: int
        } : int
      true_statement: 
      false_statement: 
        ExprStatement {
          AssignmentExpr {
            lhs: 
              VariableLValueExpr(pivot) : int
            rhs: 
              FunctionCall {
                procedure_name: partition,
                arguments: [
                  VariableExpr(array) : int*
                  VariableExpr(left) : int
                  VariableExpr(right) : int
                ]
              } : int
          } : int
        }
        ExprStatement {
          AssignmentExpr {
            lhs: 
              VariableLValueExpr(skip) : int
            rhs: 
              FunctionCall {
                procedure_name: fastSort,
                arguments: [
                  VariableExpr(array) : int*
                  VariableExpr(left) : int
                  VariableExpr(pivot) : int
                ]
              } : int
          } : int
        }
        ExprStatement {
          AssignmentExpr {
            lhs: 
              VariableLValueExpr(skip) : int
            rhs: 
              FunctionCall {
                procedure_name: fastSort,
                arguments: [
                  VariableExpr(array) : int*
                  BinaryExpr {
                    lhs: 
                      VariableExpr(pivot) : int
                    operation: Add
                    rhs: 
                      1: int
                  } : int
                  VariableExpr(right) : int
                ]
              } : int
          } : int
        }
    }
    ReturnStatement {
      0: int
    }
}

Procedure {
  name: wain
  return_type: int
  parameters: 
    a: int* (used)
    b: int (used)
  declarations: 
    i: int = 0 (used)
  statements: 
    ForStatement {
      initialization: 
        AssignmentExpr {
          lhs: 
            VariableLValueExpr(i) : int
          rhs: 
            0: int
        } : int
      condition: 
        BinaryExpr {
          lhs: 
            VariableExpr(i) : int
          operation: LessThan
          rhs: 
            VariableExpr(b) : int
        } : int
      increment: 
        AssignmentExpr {
          lhs: 
            VariableLValueExpr(i) : int
          rhs: 
            BinaryExpr {
              lhs: 
                VariableExpr(i) : int
              operation: Add
              rhs: 
                1: int
            } : int
        } : int
      body: 
        PrintStatement {
          DereferenceExpr {
            BinaryExpr {
              lhs: 
                VariableExpr(a) : int*
              operation: Add
              rhs: 
                VariableExpr(i) : int
            } : int*
          } : int
        }
    }
    ExprStatement {
      FunctionCall {
        procedure_name: fastSort,
        arguments: [
          VariableExpr(a) : int*
          0: int
          BinaryExpr {
            lhs: 
              VariableExpr(b) : int
            operation: Sub
            rhs: 
              1: int
          } : int
        ]
      } : int
    }
    ForStatement {
      initialization: 
        AssignmentExpr {
          lhs: 
            VariableLValueExpr(i) : int
          rhs: 
            0: int
        } : int
      condition: 
        BinaryExpr {
          lhs: 
            VariableExpr(i) : int
          operation: LessThan
          rhs: 
            VariableExpr(b) : int
        } : int
      increment: 
        AssignmentExpr {
          lhs: 
            VariableLValueExpr(i) : int
          rhs: 
            BinaryExpr {
              lhs: 
                VariableExpr(i) : int
              operation: Add
              rhs: 
                1: int
            } : int
        } : int
      body: 
        PrintStatement {
          DereferenceExpr {
            BinaryExpr {
              lhs: 
                VariableExpr(a) : int*
              operation: Add
              rhs: 
                VariableExpr(i) : int
            } : int*
          } : int
        }
    }
    ReturnStatement {
      0: int
    }
}

