}

Procedure {
  name: wain
  return_type: int
  parameters: 
    start: int (used)
    end: int (used)
  declarations: 
    idx: int = 0 (used)
  statements: 
    ForStatement {
      initialization: 
        AssignmentExpr {
          lhs: 
            VariableLValueExpr(idx) : int
          rhs: 
            VariableExpr(start) : int
        } : int
      condition: 
        BinaryExpr {
          lhs: 
            VariableExpr(idx) : int
          operation: LessThan
          rhs: 
            VariableExpr(end) : int
        } : int
      increment: 
        AssignmentExpr {
          lhs: 
            VariableLValueExpr(idx) : int
          rhs: 
            BinaryExpr {
              lhs: 
                VariableExpr(idx) : int
              operation: Add
              rhs: 
                1: int
            } : int
        } : int
      body: 
        PrintStatement {
          FunctionCall {
            procedure_name: fizzbuzz,
            arguments: [
              VariableExpr(idx) : int
            ]
          } : int
        }
    }
    ReturnStatement {
      VariableExpr(idx) : int
    }
}

