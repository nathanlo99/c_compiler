  statements: 
    IfStatement {
      condition: 
        BinaryExpr {
          lhs: 
            BinaryExpr {
              lhs: 
                VariableExpr(n) : int
              operation: Mod
              rhs: 
                15: int
            } : int
          operation: Equal
          rhs: 
            0: int
        } : int
      true_statement: 
        ReturnStatement {
          BinaryExpr {
            lhs: 
              0: int
            operation: Sub
            rhs: 
              15: int
          } : int
        }
      false_statement: 
    }
    IfStatement {
      condition: 
        BinaryExpr {
          lhs: 
            BinaryExpr {
              lhs: 
                VariableExpr(n) : int
              operation: Mod
              rhs: 
                3: int
            } : int
          operation: Equal
          rhs: 
            0: int
        } : int
      true_statement: 
        ReturnStatement {
          BinaryExpr {
            lhs: 
              0: int
            operation: Sub
            rhs: 
              3: int
          } : int
        }
      false_statement: 
    }
    IfStatement {
      condition: 
        BinaryExpr {
          lhs: 
            BinaryExpr {
              lhs: 
                VariableExpr(n) : int
              operation: Mod
              rhs: 
                5: int
            } : int
          operation: Equal
          rhs: 
            0: int
        } : int
      true_statement: 
        ReturnStatement {
          BinaryExpr {
            lhs: 
              0: int
            operation: Sub
            rhs: 
              5: int
