@fizzbuzz(n: int) : int {
  _t0: int = id n;
  _t1: int = const 15;
  _t2: int = mod _t0 _t1;
  _t3: int = const 0;
  _t4: int = eq _t2 _t3;
  br _t4 ifTrue0 ifFalse0;
ifTrue0:                                           preds = {fizzbuzzEntry}, dominators = {ifTrue0, fizzbuzzEntry}
  _t5: int = const 0;
  _t6: int = const 15;
  _t7: int = sub _t5 _t6;
  ret _t7;
ifFalse0:                                          preds = {fizzbuzzEntry}, dominators = {ifFalse0, fizzbuzzEntry}
  _t8: int = id n;
  _t9: int = const 3;
  _t10: int = mod _t8 _t9;
  _t11: int = const 0;
  _t12: int = eq _t10 _t11;
  br _t12 ifTrue1 ifFalse1;
ifTrue1:                                           preds = {ifFalse0}, dominators = {ifTrue1, ifFalse0, fizzbuzzEntry}
  _t13: int = const 0;
  _t14: int = const 3;
  _t15: int = sub _t13 _t14;
  ret _t15;
ifFalse1:                                          preds = {ifFalse0}, dominators = {ifFalse1, ifFalse0, fizzbuzzEntry}
  _t16: int = id n;
  _t17: int = const 5;
  _t18: int = mod _t16 _t17;
  _t19: int = const 0;
  _t20: int = eq _t18 _t19;
  br _t20 ifTrue2 ifFalse2;
ifTrue2:                                           preds = {ifFalse1}, dominators = {ifTrue2, ifFalse1, ifFalse0, fizzbuzzEntry}
  _t21: int = const 0;
  _t22: int = const 5;
  _t23: int = sub _t21 _t22;
  ret _t23;
ifFalse2:                                          preds = {ifFalse1}, dominators = {ifFalse2, ifFalse1, ifFalse0, fizzbuzzEntry}
  _t24: int = id n;
  ret _t24;
}

@wain(start: int, end: int) : int {
  idx: int = const 0;
  _t25: int = id start;
  idx: int = id _t25;
  _t26: int = id idx;
  jmp forLoop0;
forLoop0:                                          preds = {forUpdate0, wainEntry}, dominators = {forLoop0, wainEntry}
  _t27: int = id idx;
  _t28: int = id end;
  _t29: int = lt _t27 _t28;
  br _t29 forBody0 forEnd0;
forBody0:                                          preds = {forLoop0}, dominators = {forBody0, forLoop0, wainEntry}
  _t30: int = id idx;
  _t31: int = call @fizzbuzz _t30;
  print _t31;
  jmp forUpdate0;
forUpdate0:                                        preds = {forBody0}, dominators = {forUpdate0, forBody0, forLoop0, wainEntry}
  _t32: int = id idx;
  _t33: int = const 1;
  _t34: int = add _t32 _t33;
  idx: int = id _t34;
  _t35: int = id idx;
  jmp forLoop0;
forEnd0:                                           preds = {forLoop0}, dominators = {forEnd0, forLoop0, wainEntry}
  _t36: int = id idx;
  ret _t36;
}

