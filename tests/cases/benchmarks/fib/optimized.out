@fib(n: int) : int {
  %0: int = const 2;
  %1: int = lt %0 n;
  br %1 .L1 .L2;
.L1:                                               preds = {.L0}, dominators = {.L1, .L0}
  %2: int = const 1;
  %3: int = sub n %2;
  %4: int = call @fib %3;
  %5: int = sub n %0;
  %6: int = call @fib %5;
  %7: int = add %6 %4;
  %8: int = id %7;
  jmp .L3;
.L2:                                               preds = {.L0}, dominators = {.L2, .L0}
  %8: int = const 1;
  jmp .L3;
.L3:                                               preds = {.L2, .L1}, dominators = {.L3, .L0}
  ret %8;
}

@wain(a: int, b: int) : int {
  %0: int = call @fib a;
  print %0;
  ret %0;
}

