Procedure {
  name: fib
  return_type: int
  parameters: 
    n: int (used)
  declarations: 
    answer: int = 0 (used)
  statements: 
    IfStatement {
      condition: 
        BinaryExpr {
          lhs: 
            2: int
          operation: LessThan
          rhs: 
            VariableExpr(n) : int
        } : int
      true_statement: 
        ExprStatement {
          AssignmentExpr {
            lhs: 
              VariableLValueExpr(answer) : int
            rhs: 
              BinaryExpr {
                lhs: 
                  FunctionCall {
                    procedure_name: fib,
                    arguments: [
                      BinaryExpr {
                        lhs: 
                          VariableExpr(n) : int
                        operation: Sub
                        rhs: 
                          1: int
                      } : int
                    ]
                  } : int
                operation: Add
                rhs: 
                  FunctionCall {
                    procedure_name: fib,
                    arguments: [
                      BinaryExpr {
                        lhs: 
                          VariableExpr(n) : int
                        operation: Sub
                        rhs: 
                          2: int
                      } : int
                    ]
                  } : int
              } : int
          } : int
        }
      false_statement: 
        ExprStatement {
          AssignmentExpr {
            lhs: 
              VariableLValueExpr(answer) : int
            rhs: 
              1: int
          } : int
        }
    }
    ReturnStatement {
      VariableExpr(answer) : int
    }
}

Procedure {
  name: wain
  return_type: int
  parameters: 
    a: int (used)
    b: int (used)
  declarations: 
  statements: 
    ExprStatement {
      AssignmentExpr {
        lhs: 
          VariableLValueExpr(b) : int
        rhs: 
          FunctionCall {
            procedure_name: fib,
            arguments: [
              VariableExpr(a) : int
            ]
          } : int
      } : int
    }
    PrintStatement {
      VariableExpr(b) : int
    }
    ReturnStatement {
      VariableExpr(b) : int
    }
}

