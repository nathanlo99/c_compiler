@fib(n: int) : int {
  answer: int = const 0;
  _t0: int = const 2;
  _t1: int = id n;
  _t2: int = lt _t0 _t1;
  br _t2 ifTrue0 ifFalse0;
ifTrue0:                                           preds = {fibEntry}, dominators = {ifTrue0, fibEntry}
  _t3: int = id n;
  _t4: int = const 1;
  _t5: int = sub _t3 _t4;
  _t6: int = call @fib _t5;
  _t7: int = id n;
  _t8: int = const 2;
  _t9: int = sub _t7 _t8;
  _t10: int = call @fib _t9;
  _t11: int = add _t6 _t10;
  answer: int = id _t11;
  _t12: int = id answer;
  jmp ifEndif0;
ifFalse0:                                          preds = {fibEntry}, dominators = {ifFalse0, fibEntry}
  _t13: int = const 1;
  answer: int = id _t13;
  _t14: int = id answer;
  jmp ifEndif0;
ifEndif0:                                          preds = {ifFalse0, ifTrue0}, dominators = {ifEndif0, fibEntry}
  _t15: int = id answer;
  ret _t15;
}

@wain(a: int, b: int) : int {
  _t16: int = id a;
  _t17: int = call @fib _t16;
  b: int = id _t17;
  _t18: int = id b;
  _t19: int = id b;
  print _t19;
  _t20: int = id b;
  ret _t20;
}

