Procedure {
  name: fib
  return_type: int
  parameters: 
    n: int (used)
  declarations: 
    memo: int* = 1 (used)
    i: int = 0 (used)
    res: int = 0 (used)
  statements: 
    ExprStatement {
      AssignmentExpr {
        lhs: 
          VariableLValueExpr(memo) : int*
        rhs: 
          NewExpr {
            BinaryExpr {
              lhs: 
                VariableExpr(n) : int
              operation: Add
              rhs: 
                1: int
            } : int
          } : int*
      } : int*
    }
    ExprStatement {
      AssignmentExpr {
        lhs: 
          DereferenceLValueExpr {
            VariableExpr(memo) : int*
          } : int
        rhs: 
          1: int
      } : int
    }
    ExprStatement {
      AssignmentExpr {
        lhs: 
          DereferenceLValueExpr {
            BinaryExpr {
              lhs: 
                VariableExpr(memo) : int*
              operation: Add
              rhs: 
                1: int
            } : int*
          } : int
        rhs: 
          1: int
      } : int
    }
    ForStatement {
      initialization: 
        AssignmentExpr {
          lhs: 
            VariableLValueExpr(i) : int
          rhs: 
            2: int
        } : int
      condition: 
        BinaryExpr {
          lhs: 
            VariableExpr(i) : int
          operation: LessEqual
          rhs: 
            VariableExpr(n) : int
        } : int
      increment: 
        AssignmentExpr {
          lhs: 
            VariableLValueExpr(i) : int
          rhs: 
            BinaryExpr {
              lhs: 
                VariableExpr(i) : int
              operation: Add
              rhs: 
                1: int
            } : int
        } : int
      body: 
        ExprStatement {
          AssignmentExpr {
            lhs: 
              DereferenceLValueExpr {
                BinaryExpr {
                  lhs: 
                    VariableExpr(memo) : int*
                  operation: Add
                  rhs: 
                    VariableExpr(i) : int
                } : int*
              } : int
            rhs: 
              BinaryExpr {
                lhs: 
                  DereferenceExpr {
                    BinaryExpr {
                      lhs: 
                        VariableExpr(memo) : int*
                      operation: Add
                      rhs: 
                        BinaryExpr {
                          lhs: 
                            VariableExpr(i) : int
                          operation: Sub
                          rhs: 
                            1: int
                        } : int
                    } : int*
                  } : int
                operation: Add
                rhs: 
                  DereferenceExpr {
                    BinaryExpr {
                      lhs: 
                        VariableExpr(memo) : int*
                      operation: Add
                      rhs: 
                        BinaryExpr {
                          lhs: 
                            VariableExpr(i) : int
                          operation: Sub
                          rhs: 
                            2: int
                        } : int
                    } : int*
                  } : int
              } : int
          } : int
        }
    }
    ExprStatement {
      AssignmentExpr {
        lhs: 
          VariableLValueExpr(res) : int
        rhs: 
          DereferenceExpr {
            BinaryExpr {
              lhs: 
                VariableExpr(memo) : int*
              operation: Add
              rhs: 
                VariableExpr(n) : int
            } : int*
          } : int
      } : int
    }
    DeleteStatement {
      VariableExpr(memo) : int*
    }
    ReturnStatement {
      VariableExpr(res) : int
    }
}

Procedure {
  name: wain
  return_type: int
  parameters: 
    n: int (used)
    res: int (used)
  declarations: 
  statements: 
    ExprStatement {
      AssignmentExpr {
        lhs: 
          VariableLValueExpr(res) : int
        rhs: 
          FunctionCall {
            procedure_name: fib,
            arguments: [
              VariableExpr(n) : int
            ]
          } : int
      } : int
    }
    PrintStatement {
      VariableExpr(res) : int
    }
    ReturnStatement {
      VariableExpr(res) : int
    }
}

