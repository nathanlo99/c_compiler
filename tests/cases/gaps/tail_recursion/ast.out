Procedure {
  name: odd_part
  return_type: int
  parameters: 
    n: int (used)
  declarations: 
    result: int = 0 (used)
  statements: 
    ExprStatement {
      AssignmentExpr {
        lhs: 
          VariableLValueExpr(result) : int
        rhs: 
          VariableExpr(n) : int
      } : int
    }
    IfStatement {
      condition: 
        BinaryExpr {
          lhs: 
            BinaryExpr {
              lhs: 
                VariableExpr(n) : int
              operation: Mod
              rhs: 
                2: int
            } : int
          operation: Equal
          rhs: 
            0: int
        } : int
      true_statement: 
        ExprStatement {
          AssignmentExpr {
            lhs: 
              VariableLValueExpr(result) : int
            rhs: 
              FunctionCall {
                procedure_name: odd_part,
                arguments: [
                  BinaryExpr {
                    lhs: 
                      VariableExpr(n) : int
                    operation: Div
                    rhs: 
                      2: int
                  } : int
                ]
              } : int
          } : int
        }
      false_statement: 
    }
    ReturnStatement {
      VariableExpr(result) : int
    }
}

Procedure {
  name: wain
  return_type: int
  parameters: 
    n: int (used)
    unused: int (unused)
  declarations: 
  statements: 
    ReturnStatement {
      FunctionCall {
        procedure_name: odd_part,
        arguments: [
          VariableExpr(n) : int
        ]
      } : int
    }
}

