Procedure {
  name: abs
  return_type: int
  parameters: 
    n: int (used)
  declarations: 
  statements: 
    ReturnStatement {
      VariableExpr(n) : int
    }
}

Procedure {
  name: sub1
  return_type: int
  parameters: 
    n: int (used)
  declarations: 
  statements: 
    ReturnStatement {
      BinaryExpr {
        lhs: 
          VariableExpr(n) : int
        operation: Sub
        rhs: 
          1: int
      } : int
    }
}

Procedure {
  name: isOdd
  return_type: int
  parameters: 
    n: int (used)
  declarations: 
    answer: int = 0 (used)
  statements: 
    IfStatement {
      condition: 
        BinaryExpr {
          lhs: 
            VariableExpr(n) : int
          operation: Equal
          rhs: 
            0: int
        } : int
      true_statement: 
        ExprStatement {
          AssignmentExpr {
            lhs: 
              VariableLValueExpr(answer) : int
            rhs: 
              0: int
          } : int
        }
      false_statement: 
        ExprStatement {
          AssignmentExpr {
            lhs: 
              VariableLValueExpr(answer) : int
            rhs: 
              FunctionCall {
                procedure_name: isEven,
                arguments: [
                  FunctionCall {
                    procedure_name: sub1,
                    arguments: [
                      FunctionCall {
                        procedure_name: abs,
                        arguments: [
                          VariableExpr(n) : int
                        ]
                      } : int
                    ]
                  } : int
                ]
              } : int
          } : int
        }
    }
    ReturnStatement {
      VariableExpr(answer) : int
    }
}

Procedure {
  name: isEven
  return_type: int
  parameters: 
    n: int (used)
  declarations: 
    answer: int = 0 (used)
  statements: 
    IfStatement {
      condition: 
        BinaryExpr {
          lhs: 
            VariableExpr(n) : int
          operation: Equal
          rhs: 
            0: int
        } : int
      true_statement: 
        ExprStatement {
          AssignmentExpr {
            lhs: 
              VariableLValueExpr(answer) : int
            rhs: 
              1: int
          } : int
        }
      false_statement: 
        ExprStatement {
          AssignmentExpr {
            lhs: 
              VariableLValueExpr(answer) : int
            rhs: 
              FunctionCall {
                procedure_name: isOdd,
                arguments: [
                  FunctionCall {
                    procedure_name: sub1,
                    arguments: [
                      FunctionCall {
                        procedure_name: abs,
                        arguments: [
                          VariableExpr(n) : int
                        ]
                      } : int
                    ]
                  } : int
                ]
              } : int
          } : int
        }
    }
    ReturnStatement {
      VariableExpr(answer) : int
    }
}

Procedure {
  name: wain
  return_type: int
  parameters: 
    a: int (unused)
    b: int (unused)
  declarations: 
  statements: 
    ReturnStatement {
      FunctionCall {
        procedure_name: isOdd,
        arguments: [
          500: int
        ]
      } : int
    }
}

