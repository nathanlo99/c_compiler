@abs(n: int) : int {
  _t0: int = id n;
  ret _t0;
}

@isEven(n: int) : int {
  answer: int = const 0;
  _t15: int = id n;
  _t16: int = const 0;
  _t17: int = eq _t15 _t16;
  br _t17 ifTrue1 ifFalse1;
ifTrue1:                                           preds = {isEvenEntry}, dominators = {ifTrue1, isEvenEntry}
  _t18: int = const 1;
  answer: int = id _t18;
  _t19: int = id answer;
  jmp ifEndif1;
ifFalse1:                                          preds = {isEvenEntry}, dominators = {ifFalse1, isEvenEntry}
  _t20: int = id n;
  _t21: int = call @abs _t20;
  _t22: int = call @sub1 _t21;
  _t23: int = call @isOdd _t22;
  answer: int = id _t23;
  _t24: int = id answer;
  jmp ifEndif1;
ifEndif1:                                          preds = {ifFalse1, ifTrue1}, dominators = {ifEndif1, isEvenEntry}
  _t25: int = id answer;
  ret _t25;
}

@isOdd(n: int) : int {
  answer: int = const 0;
  _t4: int = id n;
  _t5: int = const 0;
  _t6: int = eq _t4 _t5;
  br _t6 ifTrue0 ifFalse0;
ifTrue0:                                           preds = {isOddEntry}, dominators = {ifTrue0, isOddEntry}
  _t7: int = const 0;
  answer: int = id _t7;
  _t8: int = id answer;
  jmp ifEndif0;
ifFalse0:                                          preds = {isOddEntry}, dominators = {ifFalse0, isOddEntry}
  _t9: int = id n;
  _t10: int = call @abs _t9;
  _t11: int = call @sub1 _t10;
  _t12: int = call @isEven _t11;
  answer: int = id _t12;
  _t13: int = id answer;
  jmp ifEndif0;
ifEndif0:                                          preds = {ifFalse0, ifTrue0}, dominators = {ifEndif0, isOddEntry}
  _t14: int = id answer;
  ret _t14;
}

@sub1(n: int) : int {
  _t1: int = id n;
  _t2: int = const 1;
  _t3: int = sub _t1 _t2;
  ret _t3;
}

@wain(a: int, b: int) : int {
  _t26: int = const 500;
  _t27: int = call @isOdd _t26;
  ret _t27;
}

