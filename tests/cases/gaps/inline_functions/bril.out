@cube(n: int) : int {
  _t3: int = id n;
  _t4: int = id n;
  _t5: int = mul _t3 _t4;
  _t6: int = id n;
  _t7: int = mul _t5 _t6;
  ret _t7;
}

@max(a: int, b: int) : int {
  _t8: int = id a;
  _t9: int = id b;
  _t10: int = lt _t8 _t9;
  br _t10 ifTrue0 ifFalse0;
ifTrue0:                                           preds = {maxEntry}, dominators = {ifTrue0, maxEntry}
  _t11: int = id b;
  a: int = id _t11;
  _t12: int = id a;
  jmp ifFalse0;
ifFalse0:                                          preds = {ifTrue0, maxEntry}, dominators = {ifFalse0, maxEntry}
  _t13: int = id a;
  ret _t13;
}

@min(a: int, b: int) : int {
  _t14: int = id a;
  _t15: int = id b;
  _t16: int = add _t14 _t15;
  _t17: int = id a;
  _t18: int = id b;
  _t19: int = call @max _t17 _t18;
  _t20: int = sub _t16 _t19;
  ret _t20;
}

@pythagoras(a: int, b: int) : int {
  _t31: int = id a;
  _t32: int = id b;
  _t33: int = call @min _t31 _t32;
  _t34: int = call @square _t33;
  _t35: int = id a;
  _t36: int = id b;
  _t37: int = call @max _t35 _t36;
  _t38: int = call @square _t37;
  _t39: int = add _t34 _t38;
  _t40: int = call @sqrt _t39;
  ret _t40;
}

@sqrt(n: int) : int {
  ans: int = const 0;
  jmp whileLoop0;
whileLoop0:                                        preds = {whileBody0, sqrtEntry}, dominators = {whileLoop0, sqrtEntry}
  _t21: int = id ans;
  _t22: int = id ans;
  _t23: int = mul _t21 _t22;
  _t24: int = id n;
  _t25: int = lt _t23 _t24;
  br _t25 whileBody0 whileEnd0;
whileBody0:                                        preds = {whileLoop0}, dominators = {whileBody0, whileLoop0, sqrtEntry}
  _t26: int = id ans;
  _t27: int = const 1;
  _t28: int = add _t26 _t27;
  ans: int = id _t28;
  _t29: int = id ans;
  jmp whileLoop0;
whileEnd0:                                         preds = {whileLoop0}, dominators = {whileEnd0, whileLoop0, sqrtEntry}
  _t30: int = id ans;
  ret _t30;
}

@square(n: int) : int {
  _t0: int = id n;
  _t1: int = id n;
  _t2: int = mul _t0 _t1;
  ret _t2;
}

@wain(a: int, b: int) : int {
  _t41: int = const 3;
  _t42: int = const 4;
  _t43: int = call @pythagoras _t41 _t42;
  _t44: int = call @cube _t43;
  ret _t44;
}

