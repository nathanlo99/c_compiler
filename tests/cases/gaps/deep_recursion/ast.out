Procedure {
  name: f
  return_type: int
  parameters: 
    a: int (used)
  declarations: 
    result: int = 0 (used)
  statements: 
    IfStatement {
      condition: 
        BinaryExpr {
          lhs: 
            VariableExpr(a) : int
          operation: Equal
          rhs: 
            0: int
        } : int
      true_statement: 
        ExprStatement {
          AssignmentExpr {
            lhs: 
              VariableLValueExpr(result) : int
            rhs: 
              0: int
          } : int
        }
      false_statement: 
        ExprStatement {
          AssignmentExpr {
            lhs: 
              VariableLValueExpr(result) : int
            rhs: 
              FunctionCall {
                procedure_name: f,
                arguments: [
                  BinaryExpr {
                    lhs: 
                      VariableExpr(a) : int
                    operation: Sub
                    rhs: 
                      1: int
                  } : int
                ]
              } : int
          } : int
        }
    }
    ReturnStatement {
      VariableExpr(result) : int
    }
}

Procedure {
  name: wain
  return_type: int
  parameters: 
    a: int (unused)
    b: int (unused)
  declarations: 
  statements: 
    ReturnStatement {
      FunctionCall {
        procedure_name: f,
        arguments: [
          FunctionCall {
            procedure_name: f,
            arguments: [
              FunctionCall {
                procedure_name: f,
                arguments: [
                  100000: int
                ]
              } : int
            ]
          } : int
        ]
      } : int
    }
}

