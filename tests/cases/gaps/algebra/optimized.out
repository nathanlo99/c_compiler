@wain(a: int, b: int) : int {
  %0: int = const 0;
  print a;
  print a;
  print a;
  print %0;
  %1: int = const 1;
  print a;
  print %0;
  %2: int = const 2;
  %3: int = mul a %2;
  print %3;
  print a;
  print %0;
  print %3;
  print %0;
  print %1;
  print %0;
  print %0;
  print %0;
  %4: int = add b a;
  %5: int = sub %4 b;
  print %5;
  ret a;
}

