@factorial(a: int) : int {
  %0: int = const 1;
  %1: int = lt %0 a;
  br %1 .L1 .L2;
.L1:                                               preds = {.L0}, dominators = {.L0, .L1}, escapes = {%4}
  %2: int = sub a %0;
  %3: int = call @factorial %2;
  %4: int = mul %3 a;
  jmp .L3;
.L2:                                               preds = {.L0}, dominators = {.L0, .L2}, escapes = {}
  jmp .L3;
.L3:                                               preds = {.L1, .L2}, dominators = {.L0, .L3}, escapes = {}
  %5: int = phi .L1 %4 .L2 %0;
  ret %5;
}

@wain(a: int, result: int) : int {
  %0: int = call @factorial a;
  ret %0;
}

