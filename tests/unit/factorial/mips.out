                                ; @factorial(a: int) : int {
                                ;   %0: int = const 1;
                                ;   %1: int = lt %0 a;
                                ;   br %1 .L1 .L2;
                                ; .L1:                                               preds = {.L0}, dominators = {.L0, .L1}
                                ;   %2: int = sub a %0;
                                ;   %3: int = call @factorial %2;
                                ;   %4: int = mul %3 a;
                                ;   %5: int = id %4;
                                ;   jmp .L3;
                                ; .L2:                                               preds = {.L0}, dominators = {.L0, .L2}
                                ;   %5: int = id %0;
                                ;   jmp .L3;
                                ; .L3:                                               preds = {.L1, .L2}, dominators = {.L0, .L3}
                                ;   ret %5;
