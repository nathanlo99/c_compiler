@wain(a: int, b: int) : int {
  %0: int = const 5;
  %1: int = const 0;
  %2: int = lt a b;
  br %2 .L1 .L4;
.L1:                                               preds = {.L0}, dominators = {.L1, .L0}
  %3: int = id %0;
  br %2 .L2 .L3;
.L2:                                               preds = {.L1}, dominators = {.L2, .L1, .L0}
  %3: int = const -5;
  jmp .L3;
.L3:                                               preds = {.L1, .L2}, dominators = {.L3, .L1, .L0}
  %4: int = sub %1 %3;
  %5: int = id %4;
  jmp .L5;
.L4:                                               preds = {.L0}, dominators = {.L4, .L0}
  %5: int = id %0;
  jmp .L5;
.L5:                                               preds = {.L4, .L3}, dominators = {.L5, .L0}
  ret %5;
}

