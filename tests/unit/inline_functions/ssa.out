@cube(n: int) : int {
  %0: int = mul n n;
  %1: int = mul %0 n;
  ret %1;
}

@max(a: int, b: int) : int {
  %0: int = lt a b;
  br %0 .L1 .L2;
.L1:                                               preds = {.L0}, dominators = {.L0, .L1}, escapes = {}
  jmp .L2;
.L2:                                               preds = {.L0, .L1}, dominators = {.L0, .L2}, escapes = {}
  %1: int = phi .L0 a .L1 b;
  ret %1;
}

@min(a: int, b: int) : int {
  %0: int = add b a;
  %1: int = call @max a b;
  %2: int = sub %0 %1;
  ret %2;
}

@pythagoras(a: int, b: int) : int {
  %0: int = call @min a b;
  %1: int = call @square %0;
  %2: int = call @max a b;
  %3: int = call @square %2;
  %4: int = add %3 %1;
  %5: int = call @sqrt %4;
  ret %5;
}

@sqrt(n: int) : int {
  %0: int = const 0;
  jmp .L1;
.L1:                                               preds = {.L0, .L2}, dominators = {.L0, .L1}, escapes = {%2}
  %2: int = phi .L0 %0 .L2 %1;
  %3: int = mul %2 %2;
  %4: int = lt %3 n;
  br %4 .L2 .L3;
.L2:                                               preds = {.L1}, dominators = {.L0, .L1, .L2}, escapes = {%1}
  %5: int = const 1;
  %1: int = add %2 %5;
  jmp .L1;
.L3:                                               preds = {.L1}, dominators = {.L0, .L1, .L3}, escapes = {}
  ret %2;
}

@square(n: int) : int {
  %0: int = mul n n;
  ret %0;
}

@wain(a: int, b: int) : int {
  %0: int = const 3;
  %1: int = const 4;
  %2: int = call @pythagoras %0 %1;
  %3: int = call @cube %2;
  ret %3;
}

