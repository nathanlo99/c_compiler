@wain(a: int, b: int) : int {
  %0: int = id a;
  %1: int = const 0;
  %2: int = eq a %1;
  br %2 .L1 .L2;
.L1:                                               preds = {.L0}, dominators = {.L0, .L1}, escapes = {%3}
  %3: int = id %1;
  jmp .L3;
.L2:                                               preds = {.L0}, dominators = {.L0, .L2}, escapes = {%3}
  %3: int = id %0;
  jmp .L3;
.L3:                                               preds = {.L1, .L2}, dominators = {.L0, .L3}, escapes = {}
  ret %3;
}

