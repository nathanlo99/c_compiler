@wain(a: int, b: int) : int {
  %0: int = const 0;
  %1: int = const 0;
  jmp .L1;
.L1:                                               preds = {.L0, .L2}, dominators = {.L0, .L1}, escapes = {%2}
  %2: int = id %1;
  %3: int = lt %1 a;
  br %3 .L2 .L3;
.L2:                                               preds = {.L1}, dominators = {.L0, .L1, .L2}, escapes = {%1}
  %4: int = const 1;
  %5: int = add %2 %4;
  %1: int = id %5;
  jmp .L1;
.L3:                                               preds = {.L1}, dominators = {.L0, .L1, .L3}, escapes = {}
  ret %0;
}

