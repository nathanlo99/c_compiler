@wain(a: int, b: int) : int {
  %0: int = const 0;
  jmp .L1;
.L1:                                               preds = {.L2, .L0}, dominators = {.L1, .L0}
  %1: int = lt %0 a;
  br %1 .L2 .L3;
.L2:                                               preds = {.L1}, dominators = {.L2, .L1, .L0}
  %2: ptr<int> = alloc b;
  %3: int = const 1;
  %4: int = add %0 %3;
  %0: int = id %4;
  jmp .L1;
.L3:                                               preds = {.L1}, dominators = {.L3, .L1, .L0}
  %5: int = const 0;
  ret %5;
}

