@odd_part(n: int) : int {
  %0: int = const 2;
  %1: int = mod n %0;
  %2: int = const 0;
  %3: int = eq %1 %2;
  br %3 .L1 .L2;
.L1:                                               preds = {.L0}, dominators = {.L0, .L1}, escapes = {%5}
  %4: int = div n %0;
  %5: int = call @odd_part %4;
  jmp .L2;
.L2:                                               preds = {.L0, .L1}, dominators = {.L0, .L2}, escapes = {}
  %6: int = phi .L0 n .L1 %5;
  ret %6;
}

@wain(n: int, unused: int) : int {
  %0: int = call @odd_part n;
  ret %0;
}

