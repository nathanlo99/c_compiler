@odd_part(n: int) : int {
  %0: int = id n;
  %1: int = const 2;
  %2: int = mod n %1;
  %3: int = const 0;
  %4: int = eq %2 %3;
  br %4 .L1 .L2;
.L1:                                               preds = {.L0}, dominators = {.L0, .L1}, escapes = {%7}
  %5: int = id %1;
  %6: int = div n %1;
  %7: int = call @odd_part %6;
  %8: int = id %7;
  jmp .L2;
.L2:                                               preds = {.L0, .L1}, dominators = {.L0, .L2}, escapes = {}
  %9: int = phi .L0 n .L1 %7;
  ret %9;
}

@wain(n: int, unused: int) : int {
  %0: int = call @odd_part n;
  ret %0;
}

