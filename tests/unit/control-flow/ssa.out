@wain(a: int, b: int) : int {
  %0: int = const 3;
  %1: int = lt a %0;
  br %1 .L1 .L2;
.L1:                                               preds = {.L0}, dominators = {.L0, .L1}, escapes = {%3}
  %2: int = const 1;
  %3: int = add a %2;
  jmp .L2;
.L2:                                               preds = {.L0, .L1}, dominators = {.L0, .L2}, escapes = {}
  %4: int = phi .L0 a .L1 %3;
  ret %4;
}

