@wain(a: int, b: int) : int {
  %0: int = const 3;
  %1: int = lt a %0;
  %2: int = id a;
  br %1 .L1 .L2;
.L1:                                               preds = {.L0}, dominators = {.L0, .L1}, escapes = {%2}
  %3: int = const 1;
  %4: int = add a %3;
  %2: int = id %4;
  jmp .L2;
.L2:                                               preds = {.L0, .L1}, dominators = {.L0, .L2}, escapes = {}
  ret %2;
}

