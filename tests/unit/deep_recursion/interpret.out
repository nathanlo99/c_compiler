@f(a: int) : int {
  %0: int = const 0;
  %1: int = eq a %0;
  br %1 .L1 .L2;
.L1:                                               preds = {.L0}, dominators = {.L0, .L1}, escapes = {%2}
  %2: int = id %0;
  jmp .L3;
.L2:                                               preds = {.L0}, dominators = {.L0, .L2}, escapes = {%2}
  %3: int = const 1;
  %4: int = sub a %3;
  %5: int = call @f %4;
  %2: int = id %5;
  jmp .L3;
.L3:                                               preds = {.L1, .L2}, dominators = {.L0, .L3}, escapes = {}
  ret %2;
}

@wain(a: int, b: int) : int {
  %0: int = const 100000;
  %1: int = call @f %0;
  %2: int = call @f %1;
  %3: int = call @f %2;
  ret %3;
}

