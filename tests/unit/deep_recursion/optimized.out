@f(a: int) : int {
  %0: int = const 0;
  %1: int = eq a %0;
  br %1 .L1 .L2;
.L1:                                               preds = {.L0}, dominators = {.L1, .L0}
  %2: int = id %0;
  jmp .L3;
.L2:                                               preds = {.L0}, dominators = {.L2, .L0}
  %3: int = const 1;
  %4: int = sub a %3;
  %5: int = call @f %4;
  %2: int = id %5;
  jmp .L3;
.L3:                                               preds = {.L2, .L1}, dominators = {.L3, .L0}
  ret %2;
}

@wain(a: int, b: int) : int {
  %0: int = const 100000;
  %1: int = call @f %0;
  %2: int = call @f %1;
  %3: int = call @f %2;
  ret %3;
}

