@is_prime(n: int) : int {
  %0: int = const 1;
  %1: int = const 2;
  %2: int = lt n %1;
  %3: int = const 1;
  br %2 .L1 .L2;
.L1:                                               preds = {.L0}, dominators = {.L1, .L0}
  %3: int = const 0;
  jmp .L2;
.L2:                                               preds = {.L1, .L0}, dominators = {.L2, .L0}
  %4: int = id %3;
  %5: int = id %1;
  jmp .L3;
.L3:                                               preds = {.L6, .L2}, dominators = {.L3, .L2, .L0}
  %6: int = id %4;
  %7: int = id %5;
  %8: int = mul %5 %5;
  %9: int = le %8 n;
  br %9 .L4 .L7;
.L4:                                               preds = {.L3}, dominators = {.L4, .L3, .L2, .L0}
  %10: int = mod n %7;
  %11: int = const 0;
  %12: int = eq %10 %11;
  %13: int = id %6;
  br %12 .L5 .L6;
.L5:                                               preds = {.L4}, dominators = {.L4, .L3, .L2, .L5, .L0}
  %13: int = id %11;
  jmp .L6;
.L6:                                               preds = {.L5, .L4}, dominators = {.L6, .L4, .L3, .L2, .L0}
  %14: int = add %7 %0;
  %4: int = id %13;
  %5: int = id %14;
  jmp .L3;
.L7:                                               preds = {.L3}, dominators = {.L7, .L3, .L2, .L0}
  ret %6;
}

@wain(num_primes: int, start_number: int) : int {
  %0: ptr<int> = alloc num_primes;
  %1: ptr<int> = id %0;
  %2: int = id start_number;
  %3: int = const 0;
  jmp .L1;
.L1:                                               preds = {.L0, .L4}, dominators = {.L1, .L0}
  %4: int = lt %3 num_primes;
  br %4 .L2 .L5;
.L2:                                               preds = {.L1, .L3}, dominators = {.L2, .L1, .L0}
  %5: int = call @is_prime %2;
  %6: int = const 0;
  %7: int = eq %5 %6;
  br %7 .L3 .L4;
.L3:                                               preds = {.L2}, dominators = {.L3, .L2, .L1, .L0}
  %8: int = const 1;
  %9: int = add %2 %8;
  %2: int = id %9;
  jmp .L2;
