  %10: int = id %2;
  %11: ptr<int> = id %1;
  %12: int = id %3;
  %13: ptr<int> = ptradd %11 %12;
  store %13 %10;
  %14: int = id %2;
  %15: int = const 1;
  %16: int = add %14 %15;
  %2: int = id %16;
  %17: int = const 1;
  %18: int = add %3 %17;
  %3: int = id %18;
  jmp .L1;
.L5:                                               preds = {.L1}, dominators = {.L5, .L1, .L0}
  %3: int = const 0;
  jmp .L6;
.L6:                                               preds = {.L7, .L5}, dominators = {.L6, .L5, .L1, .L0}
  %19: int = lt %3 num_primes;
  br %19 .L7 .L8;
.L7:                                               preds = {.L6}, dominators = {.L7, .L6, .L5, .L1, .L0}
  %20: ptr<int> = id %1;
  %21: int = id %3;
  %22: ptr<int> = ptradd %20 %21;
  %23: int = load %22;
  print %23;
  %24: int = const 1;
  %25: int = add %3 %24;
  %3: int = id %25;
  jmp .L6;
.L8:                                               preds = {.L6}, dominators = {.L8, .L6, .L5, .L1, .L0}
  %2: int = const 40;
  jmp .L9;
.L9:                                               preds = {.L8, .L13}, dominators = {.L9, .L8, .L6, .L5, .L1, .L0}
  %26: int = const 1;
  %27: int = sub %2 %26;
  %28: int = const 0;
  %29: int = ne %27 %28;
  br %29 .L10 .L14;
.L10:                                              preds = {.L9}, dominators = {.L9, .L8, .L6, .L5, .L1, .L10, .L0}
  print %2;
  %30: int = id %2;
  %31: int = const 2;
  %32: int = mod %2 %31;
  %33: int = const 0;
  %34: int = eq %32 %33;
  br %34 .L11 .L12;
.L11:                                              preds = {.L10}, dominators = {.L11, .L9, .L8, .L6, .L5, .L1, .L10, .L0}
  %35: int = const 2;
  %36: int = div %30 %35;
  %2: void = id %36;
  jmp .L13;
.L12:                                              preds = {.L10}, dominators = {.L12, .L9, .L8, .L6, .L5, .L1, .L10, .L0}
  %37: int = const 3;
  %38: int = mul %37 %30;
  %39: int = const 1;
  %40: int = add %38 %39;
  %2: void = id %40;
  jmp .L13;
.L13:                                              preds = {.L12, .L11}, dominators = {.L13, .L9, .L8, .L6, .L5, .L1, .L10, .L0}
  jmp .L9;
.L14:                                              preds = {.L9}, dominators = {.L14, .L9, .L8, .L6, .L5, .L1, .L0}
  free %1;
  %41: int = const 0;
  ret %41;
}

