  %6: int = const 1;
  %7: ptr<int> = id num;
  store %7 %6;
  jmp .L5;
.L2:                                               preds = {.L0}, dominators = {.L0, .L2}, escapes = {}
  %8: int = const 2;
  %9: int = mod %0 %8;
  %10: int = const 0;
  %11: int = eq %9 %10;
  br %11 .L3 .L4;
.L3:                                               preds = {.L2}, dominators = {.L0, .L2, .L3}, escapes = {}
  %12: int = id %0;
  %13: int = const 2;
  %14: int = div %12 %13;
  %15: ptr<int> = id num;
  store %15 %14;
  jmp .L5;
.L4:                                               preds = {.L2}, dominators = {.L0, .L2, .L4}, escapes = {}
  %16: int = const 3;
  %17: int = id %0;
  %18: int = mul %16 %17;
  %19: int = const 2;
  %20: int = add %18 %19;
  %21: int = const 1;
  %22: int = sub %20 %21;
  %23: ptr<int> = id num;
  store %23 %22;
  jmp .L5;
.L5:                                               preds = {.L1, .L3, .L4}, dominators = {.L0, .L5}, escapes = {}
  %24: int = const 0;
  ret %24;
}

@isPrime(n: int) : int {
  %0: int = const 2;
