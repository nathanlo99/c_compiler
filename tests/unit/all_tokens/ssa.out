.L6:                                               preds = {.L4, .L5}, dominators = {.L0, .L3, .L4, .L6}, escapes = {%7, %9}
  %7: int = phi .L4 %8 .L5 %11;
  %9: int = add %10 %1;
  %15: int = mul %9 %9;
  %16: int = lt n %15;
  br %16 .L7 .L8;
.L7:                                               preds = {.L6}, dominators = {.L0, .L3, .L4, .L6, .L7}, escapes = {}
  jmp .L10;
.L8:                                               preds = {.L6}, dominators = {.L0, .L3, .L4, .L6, .L8}, escapes = {}
  %17: int = eq %7 %11;
  br %17 .L9 .L10;
.L9:                                               preds = {.L8}, dominators = {.L0, .L3, .L4, .L6, .L8, .L9}, escapes = {}
  jmp .L10;
.L10:                                              preds = {.L7, .L8, .L9}, dominators = {.L0, .L10, .L3, .L4, .L6}, escapes = {%5}
  %5: int = phi .L7 %11 .L8 %6 .L9 %11;
  jmp .L3;
.L11:                                              preds = {.L3}, dominators = {.L0, .L11, .L3}, escapes = {}
  ret %8;
}

